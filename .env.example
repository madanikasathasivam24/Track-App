EXPO_PUBLIC_API_URL=https://track-api-fjkl.onrender.com
# OpenRouteService key for destination search/geocoding (autocompletePlaces)
# and Discover-tab POI search only — no longer used for route computation
# itself, see the Google Maps keys below. Free signup, no card ever:
# openrouteservice.org/dev/#/signup
EXPO_PUBLIC_ORS_API_KEY=
# Firebase project 452813236810's Google Sign-In "Web SDK configuration" client ID
# (Firebase console → Authentication → Sign-in method → Google → Web client ID),
# required by @react-native-google-signin/google-signin's GoogleSignin.configure().
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps Platform — native map rendering (react-native-maps). Read by
# app.config.js at build time only, never shipped into the JS bundle.
# Google Cloud Console (same project as above) → APIs & Services →
# Credentials — restrict each to its own platform + package/bundle ID.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
# Web map rendering (@vis.gl/react-google-maps) — this one DOES need
# EXPO_PUBLIC_ (loaded directly in-browser); restrict by HTTP referrer.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_WEB=
# Web Map ID (Google Cloud Console → Maps Management → Map IDs) — required
# for AdvancedMarker's custom marker content.
EXPO_PUBLIC_MAP_ID=
# Native Map IDs — one per platform, Map IDs can't be shared across platforms.
# Cloud Console → Maps Management → Map IDs → Create Map ID, map type
# "Android"/"iOS", then open it and paste TRACK_MAP_STYLE_GOOGLE
# (src/components/map/mapStyle.ts) into its associated style so all three
# platforms render the same look. Cloud-based styling (this) initializes
# faster than the client-side customMapStyle prop FreeMapView.tsx falls back
# to when these are unset — see FreeMapView.tsx's GOOGLE_MAP_ID comment.
EXPO_PUBLIC_GOOGLE_MAP_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_MAP_ID_IOS=

# Firebase web config — only needed for push notifications in the web preview.
# Firebase console → Project Settings → General → Your apps → Add app → Web.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Project Settings → Cloud Messaging → Web configuration → Web Push
# certificates → Generate key pair.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Microsoft Clarity session recording (native only — see
# src/services/analytics/clarity.ts). Clarity dashboard (clarity.microsoft.com)
# → your project → Settings → Overview → Project ID. Leave unset to disable.
EXPO_PUBLIC_CLARITY_PROJECT_ID=
